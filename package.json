{
  "name": "lib-voter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run chroma & next dev --turbopack",
    "build": "rm -f ./node_modules/@libsql/hrana-client/LICENSE && next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup-env": "bun run scripts/setup-env.ts",
    "validate-env": "bun run scripts/setup-env.ts validate",
    "scrape:candidates": "bun scripts/scrape-candidates.ts",
    "ingest:sources": "bun scripts/ingest-sources.ts",
    "scrape:nz-2026": "bun scripts/scrape-nz-2026.ts",
    "migrate:to-races": "bun scripts/migrate-to-races.ts",
    "test:election-config": "bun run scripts/test-election-config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "AI_MODE=mock playwright test",
    "test:e2e:live": "AI_MODE=live playwright test",
    "chroma": "docker compose up -d chroma"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
