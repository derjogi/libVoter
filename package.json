    "@types/node": "^24.5.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.5",
    "drizzle-kit": "^0.31.4",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^4.1.13",
